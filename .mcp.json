{
  "mcpServers": {
    "kaggle": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--locked",
        "--group",
        "mcp",
        "python",
        "tools/kaggle-mcp/server.py"
      ],
      "cwd": ".",
      "env": {
        "UV_CACHE_DIR": ".cache/uv"
      }
    }
  }
}
